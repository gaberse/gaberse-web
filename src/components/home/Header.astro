---
import ContactProfile from "../islands/ContactProfile";
import { localizedPath, type Locale } from "../../lib/i18n";

const { locale } = Astro.props as { locale: Locale };
const otherLocale = locale === "en" ? "es" : "en";
const labels = locale === "en"
  ? { home: "Gaberse home", navigation: "Primary navigation" }
  : { home: "Inicio de Gaberse", navigation: "Navegación principal" };
---

<div class="site-header__sentinel" aria-hidden="true"></div>
<header class="site-header">
  <a class="site-header__brand" href={localizedPath(locale)} aria-label={labels.home}>gaberse<sup aria-hidden="true">©</sup></a>
  <nav aria-label={labels.navigation}>
    <ContactProfile client:load locale={locale} />
    <span class="site-header__locales"><span aria-current="page">{locale.toUpperCase()}</span><span aria-hidden="true">/</span><a href={localizedPath(otherLocale)} lang={otherLocale}>{otherLocale.toUpperCase()}</a></span>
  </nav>
</header>

<style>
  .site-header { width: 100%; margin: 0; display: flex; align-items: center; justify-content: space-between; padding: 2rem var(--space-page); font: 500 .58rem/1 var(--font-mono); letter-spacing: .18em; text-transform: uppercase; }
  .site-header__brand { font: 620 1.5rem/1 var(--font-sans); letter-spacing: -.045em; text-transform: lowercase; text-decoration: none; }
  .site-header__brand sup { position: relative; top: -.54em; margin-left: .08em; font: 500 .42em/1 var(--font-sans); letter-spacing: 0; }
  .site-header nav { display: flex; align-items: center; gap: 1.3rem; }
  .site-header nav a { color: inherit; text-decoration: none; }
  .site-header__locales { display: flex; gap: .45rem; align-items: center; padding: .5rem .8rem; border-radius: 999px; background: var(--color-surface-soft); color: var(--color-muted); letter-spacing: .06em; }
  .site-header__locales [aria-current="page"] { color: var(--color-ink); }

  /* Only the brand pins. Swapping space-between for flex-end keeps the nav in
     exactly the same spot once the brand leaves the flex flow, so nothing shifts.
     The fixed offsets subtract the pill's own padding, so the wordmark lands on
     the same pixel it occupied in flow. */
  .site-header__sentinel { position: absolute; top: 0; left: 0; width: 1px; height: 1px; }
  .site-header--pinned { justify-content: flex-end; }
  .site-header--pinned .site-header__brand {
    position: fixed; z-index: 20;
    top: calc(2rem - .5rem); left: calc(var(--space-page) - .95rem);
    padding: .5rem .95rem; border-radius: 999px;
    background: color-mix(in srgb, var(--color-canvas) 68%, transparent);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    box-shadow: var(--shadow-object);
    animation: brand-settle 220ms ease both;
  }
  @keyframes brand-settle {
    from { opacity: 0; transform: translateY(-.35rem); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header--pinned .site-header__brand { animation: none; }
  }

  @media (max-width: 44rem) {
    .site-header { padding-top: 1.5rem; }
    .site-header nav { gap: .8rem; }
    .site-header--pinned .site-header__brand { top: calc(1.5rem - .5rem); }
  }
</style>

<script>
  // A 1px sentinel at the very top: once it scrolls out, the brand pins. Cheaper
  // and smoother than listening to every scroll event.
  const header = document.querySelector(".site-header");
  const sentinel = document.querySelector(".site-header__sentinel");

  if (header && sentinel) {
    new IntersectionObserver(
      ([entry]) => header.classList.toggle("site-header--pinned", !entry.isIntersecting),
      { threshold: 0 },
    ).observe(sentinel);
  }
</script>
