---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  dark?: boolean;
}
const { eyebrow, title, description, dark = false } = Astro.props;
---

<article class={`surface-card ${dark ? "is-dark" : ""}`}>
  <p class="surface-card__eyebrow">{eyebrow}</p>
  <h3>{title}</h3>
  <p class="surface-card__description">{description}</p>
</article>
<style>
  .surface-card {
    display: flex;
    flex-direction: column;
    min-height: 20rem;
    padding: 1.6rem;
    border-radius: var(--radius-object);
    background: var(--color-surface);
    color: var(--color-ink);
  }
  .surface-card.is-dark {
    background: var(--tone-dark-bg);
    color: var(--tone-dark-fg);
  }
  .surface-card__eyebrow {
    margin: 0;
    font: 500 var(--text-meta)/var(--leading-meta) var(--font-mono);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    opacity: 0.75;
  }
  .surface-card h3 {
    margin: 1.6rem 0 0;
    font-size: clamp(1.35rem, 1.8cqw, 1.65rem);
    letter-spacing: -0.03em;
    font-weight: 640;
  }
  .surface-card__description {
    margin: 0.85rem 0 0;
    font-size: 0.95rem;
    line-height: 1.4;
    max-width: 26ch;
  }
</style>
