---
interface Props {
  label?: string;
  tone?: "dark" | "mid" | "light" | "muted";
  src?: string;
  srcSet?: string;
  sizes?: string;
  alt?: string;
  ariaLabel?: string;
  class?: string;
}
const { label, tone = "mid", src, srcSet, sizes, alt, ariaLabel, class: className } = Astro.props;
---
<div class:list={["photo-frame", className]} aria-label={!src ? ariaLabel : undefined}>
  <div class={`photo-frame__inner photo-frame__inner--${tone}`} aria-hidden={!src}>
    {src && <img src={src} srcset={srcSet} sizes={sizes} alt={alt ?? ""} loading="lazy" decoding="async" />}
    {label && <p class="photo-frame__label">{label}</p>}
  </div>
</div>
<style>
  .photo-frame { padding: .5rem; border-radius: var(--radius-artifact); background: var(--color-surface-soft); box-shadow: var(--shadow-object); height: 100%; }
  .photo-frame__inner { position: relative; overflow: hidden; width: 100%; height: 100%; border-radius: calc(var(--radius-artifact) - .4rem); }
  .photo-frame__inner img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .photo-frame__inner--dark { background: var(--tone-dark-surface); }
  .photo-frame__inner--mid { background: var(--tone-mid-surface); }
  .photo-frame__inner--light { background: var(--tone-light-surface); }
  .photo-frame__inner--muted { background: var(--color-media-placeholder); }
  /* The label sits over whatever the frame holds, so it carries its own contrast
     rather than assuming a dark surface underneath. */
  .photo-frame__label { position: absolute; top: .9rem; left: 1rem; margin: 0; font: 500 .62rem/1.25 var(--font-mono); letter-spacing: var(--tracking-meta); text-transform: uppercase; color: var(--tone-dark-fg); opacity: .85; text-shadow: 0 1px 4px rgb(0 0 0 / .6); }
</style>
