---
import Header from "../../components/home/Header.astro";
import PhotoFrame from "../../components/primitives/PhotoFrame.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { supportedLocales, type Locale } from "../../lib/i18n";
import "../../styles/item-page.css";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const isEnglish = locale === "en";

/* A documented moment, not a case study: dates, place, what happened, what came
   after. The photographs carry it; the text only annotates them. */
const copy = isEnglish
  ? {
      itemEyebrow: "THE ORIGIN",
      title: "Laboratoria",
      meta: "FEB — AUG 2019 / LIMA",
      opening: "I'd left a degree behind and no real idea how I was going to get into tech. This is what happened next.",
      arrivingEyebrow: "01 / ARRIVING",
      arrivingText: "I got in through a side door, not a university. Six months in Lima learning frontend the only way it was taught there: by building things.",
      makingEyebrow: "02 / MAKING",
      peopleAnnotation: "9TH GENERATION / FRONT END DEVELOPMENT / LIMA / 2019",
      hackathonAnnotation: "36 HOURS / 1ER HACKATHON DE IMPACTO SOCIAL",
      hackathonCaption: "With social entrepreneurs from the Kunan network.",
      afterEyebrow: "03 / AFTER",
      afterTitle: "My first job in tech came out of that.",
      afterText: "And then another. And another. Six years later I'm still doing the same thing I started doing there: building things and trying to understand them a little better.",
      nextEyebrow: "NEXT IN THE UNIVERSE",
      nextTitle: "Travel Photography",
      nextText: "Selected frames from places that stayed with me.",
    }
  : {
      itemEyebrow: "EL ORIGEN",
      title: "Laboratoria",
      meta: "FEB — AGO 2019 / LIMA",
      opening: "Había dejado una carrera atrás y no tenía muy claro cómo iba a entrar a tecnología. Esto fue lo que pasó después.",
      arrivingEyebrow: "01 / LLEGAR",
      arrivingText: "Entré por una puerta lateral, no por la universidad. Seis meses en Lima aprendiendo frontend de la única forma que había ahí: construyendo cosas.",
      makingEyebrow: "02 / HACER",
      peopleAnnotation: "9NA GENERACIÓN / FRONT END DEVELOPMENT / LIMA / 2019",
      hackathonAnnotation: "36 HORAS / 1ER HACKATHON DE IMPACTO SOCIAL",
      hackathonCaption: "Con emprendedores sociales de la red Kunan.",
      afterEyebrow: "03 / DESPUÉS",
      afterTitle: "De ahí salió mi primer trabajo en tech.",
      afterText: "Y después otro. Y otro. Seis años más tarde sigo haciendo lo mismo que empecé a hacer ahí: construir cosas y tratar de entenderlas un poco mejor.",
      nextEyebrow: "SIGUIENTE EN EL UNIVERSO",
      nextTitle: "Fotografía de viajes",
      nextText: "Fotos elegidas de lugares que se me quedaron grabados.",
    };

const media = (name: string, widths: number[]) => ({
  src: `/media/laboratoria/laboratoria-${name}-${widths[0]}.webp`,
  srcSet: widths.map((w) => `/media/laboratoria/laboratoria-${name}-${w}.webp ${w}w`).join(", "),
});

const photos = {
  portrait: {
    ...media("portrait", [480, 800, 960]),
    alt: isEnglish
      ? "Gabriela resting her chin on her hand by a window, in black and white, during the bootcamp."
      : "Gabriela apoyando el mentón en la mano junto a una ventana, en blanco y negro, durante el bootcamp.",
  },
  people: {
    ...media("people", [480, 800, 1200]),
    alt: isEnglish
      ? "Gabriela and one of the Laboratoria coaches posing together in the workspace."
      : "Gabriela y uno de los coaches de Laboratoria posando juntos en el espacio de trabajo.",
  },
  hackathon: {
    ...media("hackathon", [480, 800, 1200]),
    alt: isEnglish
      ? "Classmates working and laughing at their laptops during the hackathon, with the event banners behind them."
      : "Compañeras trabajando y riéndose frente a las laptops durante el hackathon, con los banners del evento detrás.",
  },
};
---

<BaseLayout locale={locale} title={copy.title} description={copy.opening} path="laboratoria">
  <Header locale={locale} />
  <main class="item site-shell">
    <section class="item__hero">
      <div class="item__hero-copy">
        <p class="item__eyebrow">{copy.itemEyebrow}</p>
        <h1>{copy.title}</h1>
        <p class="lab__meta">{copy.meta}</p>
        <p class="item__intro">{copy.opening}</p>
      </div>
      <PhotoFrame class="lab__hero-photo" priority sizes="(max-width: 44rem) 90vw, 30rem" {...photos.portrait} />
    </section>

    <section class="item__section lab__arriving">
      <p class="item__eyebrow">{copy.arrivingEyebrow}</p>
      <p class="lab__note">{copy.arrivingText}</p>
    </section>

    <section class="item__section lab__making">
      <p class="item__eyebrow">{copy.makingEyebrow}</p>
      <div class="lab__plates">
        <figure class="lab__plate lab__plate--people">
          <PhotoFrame class="lab__plate-photo lab__plate-photo--people" sizes="(max-width: 44rem) 88vw, 34vw" {...photos.people} />
          <figcaption class="lab__annotation">{copy.peopleAnnotation}</figcaption>
        </figure>
        <figure class="lab__plate lab__plate--hackathon">
          <PhotoFrame class="lab__plate-photo lab__plate-photo--hackathon" sizes="(max-width: 44rem) 92vw, 60vw" {...photos.hackathon} />
          <figcaption class="lab__annotation">
            {copy.hackathonAnnotation}
            <span class="lab__annotation-note">{copy.hackathonCaption}</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="item__section lab__after">
      <p class="item__eyebrow">{copy.afterEyebrow}</p>
      <h2>{copy.afterTitle}</h2>
      <p>{copy.afterText}</p>
    </section>

    <section class="item__next">
      <p class="item__eyebrow">{copy.nextEyebrow}</p>
      <a class="item__next-link" href={`/${locale}/travel-photography`}>
        <span>{copy.nextTitle} <span aria-hidden="true">→</span></span>
        <small>{copy.nextText}</small>
      </a>
    </section>
  </main>
</BaseLayout>

<style>
  .lab__meta { margin: 1.3rem 0 0; font: 500 var(--text-meta)/var(--leading-meta) var(--font-mono); letter-spacing: var(--tracking-meta); text-transform: uppercase; color: var(--color-muted); }
  .lab__meta + .item__intro { margin-top: 1.5rem; }
  /* No min-height: with a 1/1 ratio it would force a width wider than a 320px
     screen can hold. The aspect ratio alone gives it enough presence. */
  :global(.lab__hero-photo) { aspect-ratio: 1 / 1; }

  .lab__note { margin: 1.6rem 0 0; max-width: 46ch; font-size: clamp(1.05rem, 1.4cqw, 1.25rem); line-height: 1.45; color: var(--color-ink-soft); }

  /* Plates laid out on a table, not a grid: each photograph sits on its own
     line, offset from the last, with its annotation pencilled underneath. */
  /* minmax(0,1fr) + min-width:0 so the track can shrink below the photograph's
     intrinsic width; without them the image forces the column past the viewport. */
  .lab__plates { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(3.5rem, 7cqw, 7rem); margin-top: clamp(2.2rem, 4cqw, 3.4rem); }
  .lab__plate { margin: 0; min-width: 0; }
  .lab__plate--people { width: min(100%, 34%); }
  .lab__plate--hackathon { width: min(100%, 62%); margin-left: auto; }
  :global(.lab__plate-photo--people) { aspect-ratio: .75 / 1; }
  :global(.lab__plate-photo--hackathon) { aspect-ratio: 1.34 / 1; }
  .lab__annotation { margin: 1.1rem 0 0; font: 500 var(--text-meta)/var(--leading-meta) var(--font-mono); letter-spacing: var(--tracking-meta); text-transform: uppercase; color: var(--color-muted); }
  /* The annotation sets font: 500 …/… mono; the note has to reset weight and
     line-height too, or it inherits a semibold that no other body copy uses. */
  .lab__annotation-note { display: block; margin-top: .55rem; font: 400 var(--text-caption)/var(--leading-caption) var(--font-sans); letter-spacing: 0; text-transform: none; color: var(--color-ink-soft); }

  .lab__after h2 { margin: 1.4rem 0 0; max-width: 18ch; font-size: clamp(2.4rem, 4.2cqw, 4rem); line-height: 1; letter-spacing: -.05em; font-weight: 620; }
  .lab__after p { margin: 1.8rem 0 0; max-width: 46ch; font-size: clamp(1.05rem, 1.4cqw, 1.25rem); line-height: 1.45; color: var(--color-ink-soft); }

  @media (max-width: 44rem) {
    .lab__plates { gap: 2.8rem; }
    .lab__plate--people, .lab__plate--hackathon { width: 100%; margin-left: 0; }
    :global(.lab__plate-photo--hackathon) { aspect-ratio: 1.15 / 1; }
  }
</style>
