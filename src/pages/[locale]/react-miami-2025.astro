---
import Header from "../../components/home/Header.astro";
import SurfaceCard from "../../components/primitives/SurfaceCard.astro";
import PhotoFrame from "../../components/primitives/PhotoFrame.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { supportedLocales, type Locale } from "../../lib/i18n";
import "../../styles/item-page.css";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const isEnglish = locale === "en";

/* Every source is 1024px wide, so that is the ceiling — nothing is upscaled. */
const media = (name: string) => ({
  src: `/media/react-miami/${name}-480.webp`,
  srcSet: [480, 800, 1024]
    .map((w) => `/media/react-miami/${name}-${w}.webp ${w}w`)
    .join(", "),
});

/* The event's own photographs, credited and linked below the frames. Alt text
   describes only what is visible, and names nobody but Gabriela. */
const photos = {
  gabriela: {
    ...media("rm-gabriela"),
    alt: isEnglish
      ? "Gabriela smiling at an outdoor conference gathering, holding a tall drink."
      : "Gabriela sonriendo en un encuentro al aire libre de la conferencia, con un trago alto en la mano.",
  },
  skyline: {
    ...media("rm-skyline"),
    alt: isEnglish
      ? "Miami towers lit up at night, seen from above with a metro track curving below."
      : "Las torres de Miami iluminadas de noche, vistas desde arriba, con una vía de metro curvándose abajo.",
  },
  rooftop: {
    ...media("rm-rooftop"),
    alt: isEnglish
      ? "Attendees mingling around a rooftop pool at dusk."
      : "Asistentes conversando alrededor de una piscina en una azotea al atardecer.",
  },
  people: {
    ...media("rm-people"),
    alt: isEnglish
      ? "Gabriela and two other attendees at the Tech Oasis entrance, holding React Miami stickers."
      : "Gabriela y otras dos asistentes en la entrada del Tech Oasis, con stickers de React Miami en la mano.",
  },
  panel: {
    ...media("rm-panel"),
    alt: isEnglish
      ? "Three speakers seated on stage during a panel, under blue and purple light, with the React Miami banner behind them."
      : "Tres ponentes sentados en el escenario durante un panel, bajo luz azul y violeta, con el banner de React Miami detrás.",
  },
  audience: {
    ...media("rm-audience"),
    alt: isEnglish
      ? "A full session hall seen from the side, rows of attendees under purple light."
      : "Una sala llena vista de costado, con filas de asistentes bajo luz violeta.",
  },
};

const galleryHref = "https://2025gallery.reactmiami.com/";

const copy = isEnglish
  ? {
      itemEyebrow: "EXPERIENCE / 2025",
      title: "React Miami 2025",
      intro:
        "My first time in the United States, surrounded by people from the industry I had only known from a screen.",
      heroLabel: "MIAMI / 2025",
      galleryCredit: "PHOTOS / REACT MIAMI 2025 GALLERY ↗",
      arrivalEyebrow: "THE ARRIVAL",
      arrivalTitle: "A conference, but also a threshold.",
      arrivalText:
        "I went for React. What stayed with me was everything around it: being in a new country, speaking English all day, meeting people whose work I respected, and realizing that this world felt much closer than it had from home.",
      rememberEyebrow: "THREE THINGS I REMEMBER",
      framesEyebrow: "FRAMES FROM THE CONF.",
      changedEyebrow: "WHAT CHANGED",
      changedTitle: "The distance became smaller.",
      changedText:
        "Before the trip, conferences like this belonged to a version of the industry I watched from afar. After it, I had memories inside it — conversations, faces, mistakes in English, jokes, questions, and a sense that I could return.",
      quote:
        "“I didn't come back feeling like I had arrived.\nI came back feeling like I could keep going.”",
      quoteTag: "REACT MIAMI / 2025",
      detailsEyebrow: "A FEW DETAILS",
      nextEyebrow: "NEXT IN THE UNIVERSE",
      nextTitle: "Laboratoria",
      nextText: "The door that changed the direction of my work.",
    }
  : {
      itemEyebrow: "EXPERIENCIA / 2025",
      title: "React Miami 2025",
      intro:
        "Mi primera vez en Estados Unidos, rodeada de gente de la industria que solo conocía a través de una pantalla.",
      heroLabel: "MIAMI / 2025",
      galleryCredit: "FOTOS / GALERÍA REACT MIAMI 2025 ↗",
      arrivalEyebrow: "LA LLEGADA",
      arrivalTitle: "Una conferencia, pero también un umbral.",
      arrivalText:
        "Fui por React. Lo que se me quedó fue todo lo que estaba alrededor: estar en un país nuevo, hablar inglés todo el día, conocer a gente cuyo trabajo respetaba, y darme cuenta de que ese mundo estaba mucho más cerca de lo que parecía desde casa.",
      rememberEyebrow: "TRES COSAS QUE RECUERDO",
      framesEyebrow: "IMÁGENES DE LA CONF.",
      changedEyebrow: "QUÉ CAMBIÓ",
      changedTitle: "La distancia se hizo más chica.",
      changedText:
        "Antes del viaje, conferencias como esta pertenecían a una versión de la industria que miraba de lejos. Después, tenía recuerdos por dentro — conversaciones, caras, errores en inglés, chistes, preguntas, y la sensación de que podía volver.",
      quote:
        "“No volví sintiendo que había llegado.\nVolví sintiendo que podía seguir.”",
      quoteTag: "REACT MIAMI / 2025",
      detailsEyebrow: "ALGUNOS DETALLES",
      nextEyebrow: "SIGUIENTE EN EL UNIVERSO",
      nextTitle: "Laboratoria",
      nextText: "La puerta que cambió el rumbo de mi trabajo.",
    };

const remember = isEnglish
  ? [
      {
        eyebrow: "01",
        title: "THE PEOPLE",
        description:
          "Meeting developers I had followed online made the industry feel less abstract — more human, more reachable.",
      },
      {
        eyebrow: "02",
        title: "THE LANGUAGE",
        description:
          "Using English in real conversations all day was uncomfortable at first, then surprisingly normal.",
        dark: true,
      },
      {
        eyebrow: "03",
        title: "THE SCALE",
        description:
          "Being there changed my sense of what “being part of the industry” could mean for me.",
      },
    ]
  : [
      {
        eyebrow: "01",
        title: "LA GENTE",
        description:
          "Conocer en persona a developers que seguía online hizo que la industria se sintiera menos abstracta — más humana, más alcanzable.",
      },
      {
        eyebrow: "02",
        title: "EL IDIOMA",
        description:
          "Hablar inglés en conversaciones reales todo el día fue incómodo al principio, y después sorprendentemente normal.",
        dark: true,
      },
      {
        eyebrow: "03",
        title: "LA ESCALA",
        description:
          "Estar ahí me cambió la idea de lo que “ser parte de la industria” podía significar para mí.",
      },
    ];

const details = isEnglish
  ? [
      { label: "FIRST TIME", value: "UNITED STATES" },
      { label: "CONTEXT", value: "DEVELOPER CONFERENCE" },
      { label: "LANGUAGE", value: "ENGLISH" },
      { label: "YEAR", value: "2025" },
    ]
  : [
      { label: "PRIMERA VEZ", value: "ESTADOS UNIDOS" },
      { label: "CONTEXTO", value: "CONFERENCIA DE DESARROLLADORES" },
      { label: "IDIOMA", value: "INGLÉS" },
      { label: "AÑO", value: "2025" },
    ];
---

<BaseLayout
  locale={locale}
  title={copy.title}
  description={copy.intro}
  path="react-miami-2025"
>
  <Header locale={locale} />
  <main class="item site-shell">
    <section class="item__hero rm__hero">
      <div class="item__hero-copy">
        <p class="item__eyebrow">{copy.itemEyebrow}</p>
        <h1>{copy.title}</h1>
        <p class="item__intro">{copy.intro}</p>
      </div>
      <PhotoFrame
        class="rm__hero-photo"
        priority
        label={copy.heroLabel}
        sizes="(max-width: 44rem) 88vw, 24rem"
        {...photos.gabriela}
      />
    </section>

    <section class="item__section rm__arrival">
      <div class="rm__arrival-copy">
        <p class="item__eyebrow">{copy.arrivalEyebrow}</p>
        <h2>{copy.arrivalTitle}</h2>
        <p>{copy.arrivalText}</p>
      </div>
      <div class="rm__arrival-photos">
        <PhotoFrame
          class="rm__arrival-photo rm__arrival-photo--tall"
          sizes="(max-width: 44rem) 62vw, 22rem"
          {...photos.skyline}
        />
        <PhotoFrame
          class="rm__arrival-photo rm__arrival-photo--short"
          sizes="(max-width: 44rem) 56vw, 20rem"
          {...photos.rooftop}
        />
      </div>
    </section>

    <section class="item__section rm__remember">
      <p class="item__eyebrow">{copy.rememberEyebrow}</p>
      <div class="rm__remember-grid">
        {remember.map((item) => <SurfaceCard {...item} />)}
      </div>
    </section>

    <section class="item__section rm__frames">
      <p class="item__eyebrow">{copy.framesEyebrow}</p>
      <div class="rm__frames-wall">
        <div class="rm__frames-cell rm__frames-cell--people">
          <PhotoFrame
            class="rm__frame rm__frame--landscape"
            sizes="(max-width: 44rem) 92vw, 30rem"
            {...photos.people}
          />
        </div>
        <div class="rm__frames-cell rm__frames-cell--panel">
          <PhotoFrame
            class="rm__frame rm__frame--portrait"
            sizes="(max-width: 44rem) 92vw, 17rem"
            {...photos.panel}
          />
        </div>
        <div class="rm__frames-cell rm__frames-cell--audience">
          <PhotoFrame
            class="rm__frame rm__frame--landscape"
            sizes="(max-width: 44rem) 92vw, 42rem"
            {...photos.audience}
          />
        </div>
      </div>
      <a
        class="rm__credit"
        href={galleryHref}
        target="_blank"
        rel="noopener noreferrer">{copy.galleryCredit}</a
      >
    </section>

    <section class="item__section rm__changed">
      <div class="rm__changed-copy">
        <p class="item__eyebrow">{copy.changedEyebrow}</p>
        <h2>{copy.changedTitle}</h2>
        <p>{copy.changedText}</p>
      </div>
      <div class="rm__quote">
        <p>{copy.quote}</p>
        <span>{copy.quoteTag}</span>
      </div>
    </section>

    <section class="item__section rm__details">
      <div class="rm__details-panel">
        {
          details.map((detail) => (
            <div class="rm__detail">
              <p class="item__eyebrow">{detail.label}</p>
              <strong>{detail.value}</strong>
            </div>
          ))
        }
      </div>
    </section>

    <section class="item__next">
      <p class="item__eyebrow">{copy.nextEyebrow}</p>
      <a class="item__next-link" href={`/${locale}/laboratoria`}>
        <span>{copy.nextTitle} <span aria-hidden="true">→</span></span>
        <small>{copy.nextText}</small>
      </a>
    </section>
  </main>
</BaseLayout>

<style>
  /* Every ratio below is the photograph's native one, so object-fit: cover never
     actually crops. No min-height: it would force a width the column cannot hold. */
  :global(.rm__hero-photo) {
    width: min(100%, 24rem);
    margin-left: auto;
    aspect-ratio: 0.772 / 1;
  }

  .rm__arrival {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.85fr);
    gap: clamp(2rem, 6cqw, 5rem);
    align-items: start;
  }
  .rm__arrival-copy h2 {
    margin: 1.4rem 0 0;
    max-width: 22ch;
    font-size: clamp(2rem, 3.4cqw, 3.1rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 600;
  }
  .rm__arrival-copy p:last-child {
    margin: 1.6rem 0 0;
    max-width: 46ch;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
  .rm__arrival-photos {
    position: relative;
    display: grid;
  }
  :global(.rm__arrival-photo) {
    position: relative;
  }
  :global(.rm__arrival-photo--tall) {
    width: 68%;
    aspect-ratio: 0.667 / 1;
  }
  :global(.rm__arrival-photo--short) {
    width: 62%;
    aspect-ratio: 1.5 / 1;
    margin: -3rem 0 0 auto;
  }

  .rm__remember-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.85rem, 1.35cqw, 1.35rem);
    margin-top: 2.4rem;
  }

  /* Three photographs across a twelve-column field, each offset from the last,
     rather than a tight mosaic: the week was a handful of moments, not a set. */
  /* The offset is padding on the cell, not margin on the photograph: a grid
     item's margin does not size its row, so the lowest picture would hang out
     of the grid and the credit line would ride up beside it. */
  .rm__frames-wall {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.1rem, 2cqw, 2rem);
    align-items: start;
    margin-top: clamp(2.4rem, 4cqw, 3.6rem);
  }
  .rm__frames-cell {
    min-width: 0;
  }
  .rm__frames-cell--people {
    grid-column: 1 / span 5;
    grid-row: 1;
  }
  .rm__frames-cell--panel {
    grid-column: 8 / span 3;
    grid-row: 1;
    padding-top: clamp(3rem, 6cqw, 6rem);
  }
  .rm__frames-cell--audience {
    grid-column: 4 / span 7;
    grid-row: 2;
    padding-top: clamp(2rem, 4cqw, 4rem);
  }
  :global(.rm__frame--landscape) {
    aspect-ratio: 1.5 / 1;
  }
  :global(.rm__frame--portrait) {
    aspect-ratio: 0.624 / 1;
  }

  /* The photographs are React Miami's, not mine — the credit is the link. */
  .rm__credit {
    display: inline-block;
    margin-top: clamp(1.6rem, 3cqw, 2.4rem);
    font: 500 var(--text-meta)/var(--leading-meta) var(--font-mono);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.2rem;
    transition: color 160ms ease;
  }
  .rm__credit:hover,
  .rm__credit:focus-visible {
    color: var(--color-ink);
  }

  .rm__changed {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    gap: clamp(2rem, 6cqw, 5rem);
    align-items: start;
  }
  .rm__changed-copy h2 {
    margin: 1.4rem 0 0;
    font-size: clamp(1.8rem, 3cqw, 2.7rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 600;
  }
  .rm__changed-copy p:last-child {
    margin: 1.4rem 0 0;
    max-width: 46ch;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
  .rm__quote {
    padding: 1.8rem;
    border-radius: var(--radius-artifact);
    background: var(--tone-dark-bg);
    color: var(--tone-dark-fg);
  }
  .rm__quote p {
    margin: 0;
    white-space: pre-line;
    font-size: clamp(1.15rem, 1.8cqw, 1.4rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .rm__quote span {
    display: block;
    margin-top: 1.6rem;
    font: 500 var(--text-meta)/var(--leading-meta) var(--font-mono);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    opacity: 0.7;
  }

  .rm__details-panel {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    padding: 1.8rem;
    border-radius: var(--radius-object);
    background: var(--color-surface);
  }
  .rm__detail strong {
    display: block;
    margin-top: 0.9rem;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    font-weight: 600;
  }

  @media (max-width: 44rem) {
    .rm__arrival {
      grid-template-columns: minmax(0, 1fr);
    }
    /* No fixed height: the photographs size the stack themselves now that they
       carry their native ratios, and 20rem clipped the taller one. */
    .rm__arrival-photos {
      margin-top: 1.5rem;
    }
    :global(.rm__hero-photo) {
      width: 100%;
      margin-left: 0;
    }
    :global(.rm__arrival-photo--tall) {
      width: 78%;
    }
    :global(.rm__arrival-photo--short) {
      width: 62%;
      margin-top: -2rem;
    }
    .rm__remember-grid {
      grid-template-columns: 1fr;
    }
    /* One reading column: the wall stacks and every offset is dropped. */
    .rm__frames-wall {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.2rem;
    }
    .rm__frames-cell--people,
    .rm__frames-cell--panel,
    .rm__frames-cell--audience {
      grid-column: 1 / -1;
      grid-row: auto;
      padding-top: 0;
    }
    .rm__changed {
      grid-template-columns: 1fr;
    }
    .rm__details-panel {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
