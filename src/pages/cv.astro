---
import Analytics from "@vercel/analytics/astro";
import { cvVersions } from "../lib/links";
import "../styles/global.css";

/* A destination, not a waypoint.
 *
 * This route used to redirect straight to the document. It could not work: the
 * export responds with Content-Disposition: attachment, and a navigation to an
 * attachment downloads the file without ever replacing the current document. The
 * reader was left on a page that said "downloading" with nowhere to go.
 *
 * So the page stays, and earns its place: it holds every language of the CV, it
 * still records the visit that an outbound click would hide, and it gives the CV
 * one permanent address — wherever /cv has been pasted keeps working even if the
 * files move somewhere else entirely.
 *
 * Locale-less on purpose: the choice on offer *is* the language, so prefixing the
 * route with one would be answering the question before asking it. */
const singleVersion = cvVersions.length === 1;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>CV — Gabriela López</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://gaberse.tech/cv" />
  </head>
  <body>
    <main class="cv">
      <a class="cv__brand" href="/es/">gaberse<sup aria-hidden="true">©</sup></a>

      <div class="cv__copy">
        <p class="cv__eyebrow">CURRICULUM VITAE</p>
        <h1>Gabriela López</h1>
        <p class="cv__note">
          Frontend Engineer · Lima, Perú
          <span>Siempre la versión más reciente <span aria-hidden="true">/</span> Always the latest version</span>
        </p>
      </div>

      <ul class="cv__versions" aria-label="Descargar CV / Download CV">
        {cvVersions.map(({ lang, label, note, url }) => (
          <li>
            {/* No `download` attribute: it is ignored cross-origin, and Google
                already serves the file as an attachment. */}
            <a class="cv__version" href={url} hreflang={lang}>
              <span class="cv__version-label">{label} <span aria-hidden="true">↓</span></span>
              <span class="cv__version-note">{note}</span>
            </a>
          </li>
        ))}
      </ul>

      {/* The way out. The download leaves the reader exactly here, so without
          this the page is a dead end by construction. */}
      <a class="cv__back" href="/es/">
        Ver el sitio <span aria-hidden="true">↗</span>
        <small>Back to the site</small>
      </a>
    </main>
    <Analytics />
    <style define:vars={{ versionColumns: singleVersion ? "1" : "2" }}>
      .cv { min-height: 100svh; display: grid; align-content: center; gap: clamp(2rem, 5vw, 3.2rem); padding: var(--space-page); max-width: 46rem; }
      .cv__brand { justify-self: start; font: 620 1.5rem/1 var(--font-sans); letter-spacing: -.045em; text-decoration: none; color: inherit; }
      .cv__brand sup { position: relative; top: -.54em; margin-left: .08em; font: 500 .42em/1 var(--font-sans); }

      .cv__eyebrow { margin: 0; font: 500 var(--text-meta)/var(--leading-meta) var(--font-mono); letter-spacing: var(--tracking-meta); text-transform: uppercase; color: var(--color-muted); }
      .cv__copy h1 { margin: 1.1rem 0 0; font-size: clamp(2.4rem, 7vw, 3.6rem); line-height: .95; letter-spacing: -.06em; font-weight: 620; }
      .cv__note { margin: 1.2rem 0 0; font: 400 var(--text-caption)/var(--leading-caption) var(--font-sans); color: var(--color-ink-soft); }
      /* Direct child only: a bare `span` rule would also catch the separator
         inside and break the line in three. */
      .cv__note > span { display: block; margin-top: .3rem; color: var(--color-muted); }

      /* One column when there is one language, two when there are more: the row
         should never look like it is missing a sibling. */
      .cv__versions { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--versionColumns), minmax(0, 1fr)); gap: 1rem; }
      .cv__version { display: block; padding: clamp(1.3rem, 3vw, 1.8rem); border-radius: var(--radius-artifact); background: var(--tone-dark-bg); color: var(--tone-dark-fg); text-decoration: none; transition: opacity 160ms ease; }
      .cv__version:hover, .cv__version:focus-visible { opacity: .82; }
      .cv__version-label { display: block; font-size: clamp(1.3rem, 3vw, 1.7rem); line-height: 1.05; letter-spacing: -.04em; font-weight: 620; }
      .cv__version-note { display: block; margin-top: .55rem; font: 500 .62rem/1.25 var(--font-mono); letter-spacing: var(--tracking-meta); text-transform: uppercase; opacity: .6; }

      .cv__back { justify-self: start; text-decoration: none; color: inherit; font-size: 1.05rem; letter-spacing: -.02em; font-weight: 560; }
      .cv__back small { display: block; margin-top: .25rem; font: 400 var(--text-caption)/1.3 var(--font-sans); color: var(--color-muted); }
      .cv__back:hover { color: var(--color-muted); }

      @media (max-width: 34rem) {
        .cv__versions { grid-template-columns: minmax(0, 1fr); }
      }
    </style>
  </body>
</html>
