---
import "../styles/global.css";
import type { Locale } from "../lib/i18n";
import { createSeo } from "../lib/seo";

interface Props { locale: Locale; title?: string; description?: string; path?: string; }
const { locale, title, description, path } = Astro.props;
const seo = createSeo({ locale, title, description, path });
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{seo.pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={seo.canonical} />
    <link rel="alternate" hreflang="en" href={seo.canonical.replace(`/${locale}/`, "/en/")} />
    <link rel="alternate" hreflang="es" href={seo.canonical.replace(`/${locale}/`, "/es/")} />
    <link rel="alternate" hreflang="x-default" href={seo.canonical.replace(`/${locale}/`, "/en/")} />
  </head>
  <body><slot /></body>
</html>
