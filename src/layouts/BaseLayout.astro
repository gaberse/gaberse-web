---
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";
import type { Locale } from "../lib/i18n";
import { createSeo } from "../lib/seo";

interface Props { locale: Locale; title?: string; description?: string; path?: string; }
const { locale, title, description, path } = Astro.props;
const seo = createSeo({ locale, title, description, path });
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{seo.pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={seo.canonical} />
    <link rel="alternate" hreflang="en" href={seo.alternates.en} />
    <link rel="alternate" hreflang="es" href={seo.alternates.es} />
    <link rel="alternate" hreflang="x-default" href={seo.alternates.en} />
  </head>
  <body>
    <slot />
    {/* Cookieless, so the site needs no consent banner. It reports nothing when
        the page is not served from Vercel, which is why it stays quiet in dev. */}
    <Analytics />
  </body>
</html>
