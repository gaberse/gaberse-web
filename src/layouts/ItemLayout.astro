---
import BaseLayout from "./BaseLayout.astro";
import type { Locale } from "../lib/i18n";
interface Props {
  locale: Locale;
  title: string;
  description: string;
  slug: string;
}
const { locale, title, description, slug } = Astro.props;
---

<BaseLayout {locale} {title} {description} path={slug}>
  <main><slot /></main>
</BaseLayout>
